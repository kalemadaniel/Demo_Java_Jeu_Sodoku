<?xml version="1.0" encoding="UTF-8"?>
<project name="Demo_Java_Jeu_Sodoku-impl" default="jar" basedir="..">
    <target name="init">
        <property file="nbproject/private/private.properties"/>
        <property file="nbproject/project.properties"/>
        <mkdir dir="${build.classes.dir}"/>
    </target>
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}"
               source="${javac.source}" target="${javac.target}" encoding="UTF-8"
               includeantruntime="false" debug="true"/>
    </target>
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest><attribute name="Main-Class" value="${main.class}"/></manifest>
        </jar>
    </target>
    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/></classpath>
        </java>
    </target>
    <target name="run-single" depends="run"/>
    <target name="debug" depends="compile">
        <fail unless="netbeans.home" message="Utilisez NetBeans pour le débogage."/>
        <nbjpdastart name="${main.class}" addressproperty="jpda.address" transport="dt_socket">
            <classpath><pathelement location="${build.classes.dir}"/></classpath>
            <sourcepath><pathelement location="${src.dir}"/></sourcepath>
        </nbjpdastart>
        <java classname="${main.class}" fork="true" failonerror="true">
            <jvmarg value="-agentlib:jdwp=transport=dt_socket,address=${jpda.address},server=n,suspend=y"/>
            <classpath><pathelement location="${build.classes.dir}"/></classpath>
        </java>
    </target>
    <target name="debug-single" depends="debug"/>
    <target name="clean">
        <property file="nbproject/project.properties"/>
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
    <target name="rebuild" depends="clean,jar"/>
</project>
